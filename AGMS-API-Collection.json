              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Tomato Zone\",\n  \"description\": \"Updated description\",\n  \"minTemp\": 19.0,\n  \"maxTemp\": 29.0,\n  \"minHumidity\": 55.0,\n  \"maxHumidity\": 85.0\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/zones/1",
              "host": ["{{base_url}}"],
              "path": ["api", "zones", "1"]
